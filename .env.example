# DC.news on Mantle — environment template
# Copy to `.env` and fill in your values. `.env` is gitignored.

# === Mantle Network ===
# Get MNT for testnet at https://faucet.sepolia.mantle.xyz/
MANTLE_RPC_URL=https://rpc.sepolia.mantle.xyz
MANTLE_CHAIN_ID=5003
MANTLE_PRIVATE_KEY=0x...  # 0x-prefixed 64-char hex. NEVER commit.

# Mainnet (for final deploy on Day 2-3)
MANTLE_MAINNET_RPC=https://rpc.mantle.xyz
MANTLE_MAINNET_CHAIN_ID=5000

# === Mantle Explorer (for contract verification) ===
MANTLE_SCAN_API_KEY=  # https://mantlescan.xyz/myapikey (free tier)

# === Gemini (LLM for signal grading) ===
# Hackathon requires Google Cloud Agent Builder + Gemini 3
GEMINI_API_KEY=  # https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-2.5-pro  # upgrade to gemini-3-pro when GA

# === MongoDB Atlas (signal corpus + dedup) ===
MONGO_URI=mongodb+srv://...
MONGO_DB=dc_signals
MONGO_VECTOR_INDEX=signal_embeddings

# === Source feeds ===
GITHUB_TOKEN=ghp_...  # for higher gh API rate limits
SEC_USER_AGENT="DC.news Agent contact@example.com"  # SEC EDGAR requires UA
